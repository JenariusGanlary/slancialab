generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum HookType {
  CONTRARIAN
  CURIOSITY
  QUESTION
  STATEMENT
  STORY
  PROBLEM
  BENEFIT
  OTHER
}

enum ContentStructure {
  CLAIM_EXPLANATION
  HOOK_BODY_CTA
  PROBLEM_SOLUTION
  STORY_LESSON
  LIST
  FRAMEWORK
  QUESTION_ANSWER
  OTHER
}

enum Tone {
  NEUTRAL
  EDUCATIONAL
  PROVOCATIVE
  CONVERSATIONAL
  INSPIRATIONAL
  HUMOROUS
  AUTHORITATIVE
  PERSONAL
  OTHER
}

enum ContentFormat {
  OPINION
  EDUCATIONAL
  STORY
  FRAMEWORK
  LIST
  QUESTION
  OBSERVATION
  THREAD
  OTHER
}

enum CtaType {
  NONE
  QUESTION
  FOLLOW
  REPLY
  CLICK
  SHARE
  SIGNUP
  OTHER
}

enum ContentStyle {
  STORY
  EDUCATIONAL
  OPINION
  ENTERTAINMENT
  PERSONAL
  FRAMEWORK
  LIST
  OBSERVATIONAL
  OTHER
}

enum Stance {
  CONTRARIAN
  CONVENTIONAL
  NEUTRAL
}

enum SentenceType {
  QUESTION
  STATEMENT
}

enum Personalization {
  PERSONAL
  GENERIC
}

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  niche         String[] @default([])
  followerStage String?
  goal          String?
  firstAction   String?
  createdAt     DateTime @default(now())

  experiments Experiment[]
  xAccount    XAccount?
}

model XAccount {
  id     String @id @default(cuid())
  userId String @unique

  // X account identity
  xUserId         String  @unique
  username        String?
  displayName     String?
  profileImageUrl String?

  // OAuth tokens
  // These values must be encrypted before being stored.
  accessTokenEncrypted  String
  refreshTokenEncrypted String?

  // OAuth token lifecycle
  tokenExpiresAt DateTime?

  // OAuth scopes granted to this connection
  scopes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Posts fetched from this connected X account
  xPosts XPost[]
}

model XPost {
  id String @id @default(cuid())

  // Connection that owns this X post
  xAccountId String

  // Permanent X post identifier
  // This prevents the same X post from being imported multiple times.
  xPostId String @unique

  // Raw post data
  content String?
  postUrl String?

  // X publication timestamp
  publishedAt DateTime?

  // Performance metrics
  views   Int?
  likes   Int?
  replies Int?
  reposts Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  xAccount XAccount @relation(fields: [xAccountId], references: [id], onDelete: Cascade)

  @@index([xAccountId])
  @@index([publishedAt])
}

model Strategy {
  id          String   @id @default(cuid())
  title       String
  description String
  nicheTags   String[]
  stageTags   String[]

  // Reusable experiment template
  hypothesisTemplate      String?
  protocolTemplate        String?
  recommendedDurationDays Int?
  recommendedPostCount    Int?
  primaryMetric           String?
  successThresholdPercent Int?

  createdAt DateTime @default(now())

  experiments Experiment[]
}

model Experiment {
  id                String   @id @default(cuid())
  userId            String
  strategyId        String
  researchFindingId String?

  status      String   @default("active")
  startedAt   DateTime @default(now())
  completedAt DateTime?

  hypothesis String?
  protocol   String?

  durationDays            Int?
  targetPostCount         Int?
  primaryMetric           String?
  successThresholdPercent Int?

  baselineAverage    Float?
  baselineSampleSize Int?
  baselineCapturedAt DateTime?

  user            User             @relation(fields: [userId], references: [id])
  strategy        Strategy         @relation(fields: [strategyId], references: [id])
  researchFinding ResearchFinding? @relation(fields: [researchFindingId], references: [id])
  checkIns        CheckIn[]
  posts           ExperimentPost[]
  result          ExperimentResult?
}

model CheckIn {
  id            String   @id @default(cuid())
  experimentId  String
  followerCount Int
  loggedAt      DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id])
}

model ExperimentPost {
  id           String @id @default(cuid())
  experimentId String

  postId  String?
  postUrl String?

  content String?

  publishedAt DateTime?

  views   Int?
  likes   Int?
  replies Int?
  reposts Int?

  createdAt DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id])
}

model ExperimentResult {
  id           String   @id @default(cuid())
  experimentId String   @unique

  status                  String
  primaryMetric           String
  postsMeasured           Int
  baselineAverage         Float?
  baselineSampleSize      Int?
  experimentAverage       Float?
  absoluteChange          Float?
  percentageChange        Float?
  successThresholdPercent Int?

  recordedAt DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id])
}

model Creator {
  id        String   @id @default(cuid())
  name      String
  handle    String
  niche     String
  notes     String
  createdAt DateTime @default(now())

  posts            CreatorPost[]
  researchFindings ResearchFinding[]
}

model ResearchFinding {
  id        String @id @default(cuid())
  creatorId String

  dimension String
  pattern   String

  signalLevel String

  postCount         Int
  measuredCount     Int
  evidenceLabel     String
  medianLiftPercent Int?

  createdAt DateTime @default(now())

  creator     Creator      @relation(fields: [creatorId], references: [id])
  experiments Experiment[]
}

model CreatorPost {
  id        String   @id @default(cuid())
  creatorId String

  patternTag  String?
  content     String?
  observation String?
  postUrl     String?
  createdAt   DateTime @default(now())

  publishedAt DateTime?

  views   Int?
  likes   Int?
  replies Int?
  reposts Int?

  hookType        HookType?
  structure       ContentStructure?
  topic           String?
  tone            Tone?
  format          ContentFormat?
  ctaType         CtaType?
  contentLength   Int?
  contentStyle    ContentStyle?
  stance          Stance?
  sentenceType    SentenceType?
  personalization Personalization?

  researchNotes String?

  creator Creator @relation(fields: [creatorId], references: [id])
}